{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/家居藥物回收計劃",
      "destination": "/家居藥物回收計劃.html"
    },
    {
      "source": "/藥物分類搜尋引擎器",
      "destination": "/藥物分類搜尋引擎器.html"
    },
    {
      "source": "/:path*",
      "destination": "/:path*.html"
    }
  ],
  "headers": [
    {
      "source": "/config.yml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/yaml"
        }
      ]
    }
  ]
}