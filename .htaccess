# Apache .htaccess for Clean Chinese URLs
# Hygiene First Website - Traditional Chinese Pages

# Enable URL rewriting
RewriteEngine On

# Set UTF-8 encoding
AddDefaultCharset UTF-8

# Specific rules for Chinese pages
RewriteRule ^家居藥物回收計劃/?$ /家居藥物回收計劃.html [L]
RewriteRule ^藥物分類搜尋引擎器/?$ /藥物分類搜尋引擎器.html [L]

# General rule: add .html extension if file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Handle trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]

# Security headers
Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
Header always set X-XSS-Protection "1; mode=block"

# Cache control for static files
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg)$">
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
</FilesMatch>