{
  "name": "hygiene-first-admin",
  "version": "1.0.0",
  "description": "Hygiene First Admin Panel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "sitemap": "node sitemap-generator.js",
    "sitemap:watch": "nodemon sitemap-generator.js",
    "meta": "node meta-tag-generator.js",
    "meta:all": "node meta-tag-generator.js",
    "seo": "node seo-generator.js",
    "seo:all": "node seo-generator.js",
    "ga:setup": "echo 'Please update G-XXXXXXXXXX in google-analytics-config.js and meta-tag-generator.js with your actual GA4 tracking ID'",
    "ga:test": "node test-google-analytics.js",
    "seo:urls": "node seo-url-generator.js",
    "cms:generate": "node cms-generator.js",
    "cms:watch": "nodemon cms-generator.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
} 