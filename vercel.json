{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
        {
          "source": "/admin/auth",
          "destination": "/admin/auth.html"
        },
        {
          "source": "/admin/simple-auth",
          "destination": "/admin/simple-auth.html"
        },
    {
      "source": "/admin/cms",
      "destination": "/admin/cms.html"
    },
    {
      "source": "/admin/simple-cms",
      "destination": "/admin/simple-cms.html"
    },
    {
      "source": "/家居藥物回收計劃",
      "destination": "/家居藥物回收計劃.html"
    },
    {
      "source": "/藥物分類搜尋引擎器",
      "destination": "/藥物分類搜尋引擎器.html"
    },
    {
      "source": "/news/drug-safety-guide",
      "destination": "/news-detail-drug-safety-guide.html"
    },
    {
      "source": "/news/:slug",
      "destination": "/news-detail-:slug.html"
    },
    {
      "source": "/news-dynamic",
      "destination": "/news-dynamic.html"
    },
    {
      "source": "/news-detail-dynamic",
      "destination": "/news-detail-dynamic.html"
    },
    {
      "source": "/services-dynamic",
      "destination": "/services-dynamic.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/service-:slug.html"
    },
    {
      "source": "/drugs/:slug",
      "destination": "/drug-:slug.html"
    },
    {
      "source": "/collection-points/:slug",
      "destination": "/collection-point-:slug.html"
    },
    {
      "source": "/pages/:slug",
      "destination": "/page-:slug.html"
    },
    {
      "source": "/最新消息",
      "destination": "/news-dynamic.html"
    },
    {
      "source": "/%E6%9C%80%E6%96%B0%E6%B6%88%E6%81%AF",
      "destination": "/news-dynamic.html"
    },
    {
      "source": "/news-dynamic-chinese",
      "destination": "/news-dynamic.html"
    },
    {
      "source": "/:path*",
      "destination": "/:path*.html"
    }
  ],
  "headers": [
    {
      "source": "/config.yml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/yaml"
        }
      ]
    }
  ]
}